{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ordiseq",
  "version": "0.1.0",
  "identifier": "tech.rymcg.ordiseq",
  "build": {
    "beforeDevCommand": "node gen_icons.mjs && cd frontend && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "node gen_icons.mjs && cd frontend && npm run build",
    "frontendDist": "frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Ordiseq Mothership",
        "width": 600,
        "height": 500,
        "minWidth": 600,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "icons/*"
    ]
  }
}
